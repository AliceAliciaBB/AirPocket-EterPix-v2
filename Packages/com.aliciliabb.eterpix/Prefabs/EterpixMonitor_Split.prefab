  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "EterPix\u306F\u3001VRChat\u3067\u64AE\u5F71\u3057\u305F\u5199\u771F\u3092\u5171\u6709\u3067\u304D\u308BSNS\u3067\u3059\u3002\u3053\u306E\u30E2\u30CB\u30BF\u30FC\u3067\u306F\u3001EterPix\u306B\u6295\u7A3F\u3055\u308C\u305F\u516C\u958B\u5199\u771F\u3092\u95B2\u89A7\u3067\u304D\u307E\u3059\u3002\n\n<b>\u30DA\u30FC\u30B8\u3092\u5207\u308A\u66FF\u3048\u308B</b>\n\u5199\u771F\u306E\u5DE6\u53F3\u3092\u62BC\u3059\u3068\u3001\u524D\u5F8C\u306E\u6295\u7A3F\u306B\u5207\u308A\u66FF\u308F\u308A\u307E\u3059\u3002\u8868\u793A\u4E2D\u306E\u30DA\u30FC\u30B8\u306F\u3001\u3053\u306E\u30A4\u30F3\u30B9\u30BF\u30F3\u30B9\u306B\u3044\u308B\u5168\u54E1\u3067\u5171\u6709\u3055\u308C\u307E\u3059\u3002\n\n<b>\u30EF\u30FC\u30EB\u30C9\u3078\u884C\u304F</b>\n\u5199\u771F\u306B\u30EF\u30FC\u30EB\u30C9\u60C5\u5831\u304C\u3042\u308B\u5834\u5408\u306F\u300C\u30DD\u30FC\u30BF\u30EB\u3092\u958B\u304F\u300D\u3092\u62BC\u3059\u3068\u3001\u64AE\u5F71\u3055\u308C\u305F\u30EF\u30FC\u30EB\u30C9\u3078\u306E\u30DD\u30FC\u30BF\u30EB\u304C\u958B\u304D\u307E\u3059\u3002\n\n<b>\u518D\u8AAD\u307F\u8FBC\u307F</b>\n\u53F3\u4E0A\u306E\u518D\u8AAD\u307F\u8FBC\u307F\u30DC\u30BF\u30F3\u3067\u3001\u6295\u7A3F\u306E\u4E00\u89A7\u3092\u53D6\u308A\u76F4\u3057\u307E\u3059\u3002\u3042\u306A\u305F\u306B\u3060\u3051\u53CD\u6620\u3055\u308C\u307E\u3059\u3002\u4E00\u5EA6\u62BC\u3059\u3068\u3001\u3057\u3070\u3089\u304F\u306F\u62BC\u305B\u307E\u305B\u3093\u3002\n\n<b>\u8868\u793A\u8272\u3092\u5909\u3048\u308B</b>\n\u53F3\u4E0A\u306E\u5207\u66FF\u30DC\u30BF\u30F3\u3067\u3001\u9ED2\u30FB\u767D\u306A\u3069\u306E\u8868\u793A\u8272\u3092\u5207\u308A\u66FF\u3048\u3089\u308C\u307E\u3059\u3002\u5207\u308A\u66FF\u3048\u306F\u3042\u306A\u305F\u306B\u3060\u3051\u53CD\u6620\u3055\u308C\u3001\u6B21\u306B\u6765\u305F\u3068\u304D\u3082\u4FDD\u6301\u3055\u308C\u307E\u3059(\u30EF\u30FC\u30EB\u30C9\u306B\u3088\u3063\u3066\u306F\u5207\u308A\u66FF\u3048\u3067\u304D\u307E\u305B\u3093)\u3002\n\n<b>Pad\u3084Web\u3067\u898B\u308B</b>\n\u4E0B\u306E\u300CPad\u7528URL\u3092\u8868\u793A\u300D\u3092\u62BC\u3059\u3068\u3001\u8868\u793A\u4E2D\u306E\u6295\u7A3F\u3092Pad\u3067\u898B\u308B\u305F\u3081\u306EURL\u304C\u51FA\u307E\u3059\u3002\u30B3\u30D4\u30FC\u3057\u3066Pad\u306EURL\u6B04\u306B\u8CBC\u308A\u4ED8\u3051\u3066\u304F\u3060\u3055\u3044\u3002\u300CWeb\u30DA\u30FC\u30B8\u306EURL\u3092\u8868\u793A\u300D\u3092\u62BC\u3059\u3068\u3001\u6295\u7A3F\u306EWeb\u30DA\u30FC\u30B8\u306EURL\u304C\u51FA\u307E\u3059\u3002\u30D6\u30E9\u30A6\u30B6\u3067\u958B\u3044\u3066\u304F\u3060\u3055\u3044\u3002\n\n<b>\u30B0\u30EB\u30FC\u30D7</b>\n\u53F3\u4E0A\u306E\u30B0\u30EB\u30FC\u30D7\u30DC\u30BF\u30F3\u3067\u3001EterPix\u306EVRChat\u30B0\u30EB\u30FC\u30D7\u306E\u6848\u5185\u304C\u958B\u304D\u307E\u3059\u3002\n\n<b>\u5199\u771F\u3092\u6295\u7A3F\u3059\u308B</b>\n\u6295\u7A3F\u306FWeb\u304B\u3089\u884C\u3048\u307E\u3059\u3002\u4E0B\u306EURL\u3092\u30B3\u30D4\u30FC\u3057\u3066\u3001\u30D6\u30E9\u30A6\u30B6\u3067\u958B\u3044\u3066\u304F\u3060\u3055\u3044\u3002"
